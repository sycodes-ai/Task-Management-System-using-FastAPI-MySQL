# Copy to .env and edit. Never commit the real .env file.
# Every variable is optional except SECRET_KEY in production.

# --- Backend (read by app/core/config.py) ---

# "development" or "production". In production SECRET_KEY is required.
ENVIRONMENT=development

# Database connection. Default: sqlite:///./tasks.db
#   MySQL:      mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE
#   PostgreSQL: postgresql://USER:PASSWORD@HOST/DATABASE  (postgres:// also works)
DATABASE_URL=sqlite:///./tasks.db

# Secret used to sign login tokens. Use a long random string, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development a random key is generated at start-up if this is empty.
SECRET_KEY=

# JWT signing algorithm and token lifetime in minutes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Prefix of the API routes
API_V1_STR=/api/v1

# Comma-separated list of browser origins allowed to call the API.
# Not needed when the React app is served by FastAPI (same origin).
CORS_ORIGINS=http://localhost:5173

# "true" creates the demo users and tasks when the users table is empty
DEMO_MODE=false

# Folder with the React build (it must contain index.html).
# Default: my-react-app/dist. If it does not exist the app runs API-only.
# STATIC_DIR=

# Port the container listens on (the Docker image reads this; Render sets it)
# PORT=8000

# --- Frontend (read by Vite when the React app is built or run) ---

# API base URL. Default: /api/v1 (same origin; proxied to port 8000 in `npm run dev`)
# VITE_API_URL=

# Set to "false" to hide the demo accounts box on the login page.
# For Docker: docker build --build-arg VITE_DEMO_MODE=false .
# VITE_DEMO_MODE=true

# --- Tests ---

# Optional: also run the database test against a real MySQL (an empty throwaway database;
# its tables are dropped afterwards). Skipped when empty.
# TEST_DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/tms_test

# --- docker-compose.yml (local MySQL demo; these defaults are for local use only) ---

# MYSQL_ROOT_PASSWORD=root_password
# MYSQL_DATABASE=tms
# MYSQL_USER=tms
# MYSQL_PASSWORD=tms_password
